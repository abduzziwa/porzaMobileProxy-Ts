# Copy to .env and fill in real values. Never commit .env.

PORT=
# docker compose only: host port the app is published on (container always
# listens on 3000 internally). Leave unset to default to 3000; override only
# if something else on this machine already holds port 3000.
APP_PORT=
END_POINT=
SERVER_URL=
AUTH_CREDENTIALS=
ENCRYPTION_KEY=
API_KEY=

TYPESENSE_BASE_URL=
TYPESENSE_API_KEY=
TYPESENSE_HASH=
TYPESENSE_CID=

CORENIO_BASE_URL=
CORENIO_API_KEY=

RSA_PRIVATE_KEY_PATH=./private.pem
RSA_PUBLIC_KEY_PATH=./public.pem
# docker compose only: these two get overridden automatically to the
# keypair auto-generated by the "keygen" service on first `docker compose
# up` — no manual openssl step, no need to edit these for that path.

PG_HOST=
PG_USER=
PG_PASSWORD=
PG_DB=
PG_PORT=

REDIS_HOST=
REDIS_PORT=

MAX_TABS=
BRAND_LOGO_URL=
CUSTOMER_CARE_NUMBER=
PUBLIC_API_BASE_URL=
# GET /v3/legal/privacy-policy redirects here. Falls back to
# https://zoekonderdeel.nl/privacy-policy if unset.
PRIVACY_POLICY_URL=

# Push notifications (Corenio -> proxy -> Firebase Cloud Messaging)
INTERNAL_NOTIFICATIONS_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
